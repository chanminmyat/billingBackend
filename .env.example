# Application
PORT=4000
NODE_ENV=development
APP_TIMEZONE=Asia/Yangon

# Comma-separated frontend origins for CORS (production/custom domains)
# Example: CORS_ALLOWED_ORIGINS=https://billcollection.vercel.app,https://app.yourdomain.com,https://yourdomain.com
CORS_ALLOWED_ORIGINS=

# Option A: single DATABASE_URL (e.g. Supabase connection pooling)
# DATABASE_URL=postgresql://username:password@host:6543/postgres?pgbouncer=true

# Option B: traditional Postgres connection variables
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=password
DB_NAME=billing
DB_SSL=false
DB_SYNCHRONIZE=true

# Token expiry in minutes for reset flows
PASSWORD_RESET_TOKEN_MINUTES=30

# Default admin seed (used by yarn seed:admin)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ChangeMe123!
ADMIN_NAME=System Admin
